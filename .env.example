APP_NAME="REAL / REMAX HomeToken"
NODE_ENV=development
DEMO_MODE=true

WEB_PORT=3000
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
API_BASE_URL=http://localhost:4000

DATABASE_URL=postgresql://hometoken:hometoken@localhost:5432/hometoken

AUTH_JWT_SECRET=replace-with-local-dev-secret
DEMO_AGENT_EMAIL=agent@hometoken.demo
DEMO_AGENT_PASSWORD=demo-password

# Leave ANTHROPIC_API_KEY empty to run without live AI. Ask This Home falls back to
# the local record index and Add Record falls back to the manual entry form; both
# label themselves as fallbacks in the UI.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

STORAGE_DRIVER=local
LOCAL_STORAGE_PATH=./storage/demo-uploads
