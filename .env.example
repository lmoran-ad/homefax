APP_NAME="REAL / REMAX HomeFax"
NODE_ENV=development
DEMO_MODE=true

# The dataset is written against a fixed reference date so expiry countdowns
# and "provisioned today" read the same on any day. Unset to use real time.
DEMO_TODAY=2026-08-28

WEB_PORT=3000
WEB_ORIGIN=http://localhost:3000

DATABASE_URL=postgresql://homefax:homefax@localhost:5432/homefax

AUTH_JWT_SECRET=replace-with-local-dev-secret

# Leave ANTHROPIC_API_KEY empty to run without live AI. Ask This Home falls back
# to the local record index and Add Record drops to manual entry; both label
# themselves as fallbacks in the UI.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# local    = documents on disk (development)
# database = document bytes in PostgreSQL, for hosts with no durable disk
STORAGE_DRIVER=local
LOCAL_STORAGE_PATH=./storage/demo-uploads

# Set this to enable POST /api/admin/seed, which loads the demo dataset into
# whatever database this instance points at. Without it the route 404s.
SEED_SECRET=

# ---------------------------------------------------------------------------
# Live public-data sources. Unset, every provider is fixture-backed, which is
# what keeps the seeded demo and the e2e suite deterministic.
#
# Set to `denver` to read real parcels and real building permits from the
# county's open-data endpoints. The fixture stays behind each one, so a portal
# that is down or renamed degrades instead of breaking a page.
#
# GET /api/admin/sources probes whatever is configured and returns the layer's
# real column names with a sample row — start there, because every
# jurisdiction names its columns differently.
# PARCEL_SOURCE=denver
# PERMIT_SOURCE=denver

# Correct a column name without waiting for a build. Both are merged over the
# descriptor in packages/providers/src/live/sources.ts; a malformed value is
# ignored and reported by /api/admin/sources rather than thrown.
# PARCEL_SOURCE_URL=https://.../FeatureServer/0
# PARCEL_SOURCE_FIELDS={"address":"SITUS_ADDRESS","parcelId":"SCHEDNUM"}
# PERMIT_SOURCE_DOMAIN=data.example.gov
# PERMIT_SOURCE_DATASET=abcd-1234
# PERMIT_SOURCE_FIELDS={"permitNumber":"permit_num","issuedAt":"issue_date"}

# Optional and free. Socrata throttles anonymous requests on a shared pool.
# SOCRATA_APP_TOKEN=

# ---------------------------------------------------------------------------
# Optional: run the API as a separate Fastify service instead of in-process.
#
# Unset (the default), the web app runs Fastify inside its own route handler,
# so `pnpm --filter @homefax/web dev` is the whole stack. Set it, and the web
# app proxies to the standalone service started by `pnpm --filter @homefax/api
# dev` — useful when working on the API alone.
# API_BASE_URL=http://localhost:4000
# API_PORT=4000
