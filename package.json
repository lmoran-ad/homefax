{
  "name": "homefax",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "playwright test",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter @homefax/db migrate",
    "db:seed": "pnpm --filter @homefax/db seed",
    "db:reset": "pnpm --filter @homefax/db reset"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "22.13.5",
    "turbo": "2.10.12",
    "typescript": "5.7.3",
    "vitest": "4.1.11"
  }
}
