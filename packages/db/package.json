{
  "name": "@hometoken/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts",
    "./fixtures": "./src/seed/fixtures/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "generate": "drizzle-kit generate",
    "migrate": "tsx src/migrate.ts",
    "seed": "tsx src/seed/index.ts",
    "reset": "tsx src/reset.ts && tsx src/migrate.ts && tsx src/seed/index.ts",
    "test": "vitest run --passWithNoTests",
    "verify": "tsx scripts/verify-seed.ts"
  },
  "dependencies": {
    "@hometoken/auth": "workspace:*",
    "@hometoken/config": "workspace:*",
    "@hometoken/contracts": "workspace:*",
    "@hometoken/ledger": "workspace:*",
    "drizzle-orm": "0.45.2",
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@types/node": "22.13.5",
    "@types/pg": "8.11.10",
    "dotenv": "16.4.7",
    "drizzle-kit": "0.31.10",
    "tsx": "4.19.2",
    "typescript": "5.7.3",
    "vitest": "4.1.11"
  }
}
